<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Nazare is a self-improving AI system for autonomous software evolution."
    />
    <title>Nazare</title>
  </head>
  <body class="min-h-svh bg-[#f1f1ee] font-mono text-[#171717] antialiased dark:bg-[#151515] dark:text-[#e8e8e3]">
